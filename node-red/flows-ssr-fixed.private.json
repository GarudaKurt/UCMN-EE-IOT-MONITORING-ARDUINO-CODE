        "func":  "const p = msg.payload || {};\nconst timestamp = new Date().toISOString();\n\nfunction reading(sensor, data) {\n    data = data || {};\n\n    return {\n        sensor: sensor,\n        voltage_v: Number(data.voltage) || 0,\n        current_a: Number(data.current) || 0,\n        power_w: Number(data.power) || 0,\n        energy_kwh: Number(data.energy) || 0,\n        timestamp: timestamp\n    };\n}\n\nmsg.headers = {\n    ...(msg.headers || {}),\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    p_device_id: p.device_id || \"esp32-monitoring\",\n    p_readings: [\n        reading(\"Sala\", p.sala),\n        reading(\"Living Room\", p.livingroom),\n        reading(\"Master Bedroom\", p.master)\n    ]\n};\n\nreturn msg;",
