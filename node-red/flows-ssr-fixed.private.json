    {
        "id":  "169ada7adef59fcf",
        "type":  "function",
        "z":  "bbccb9c049c10965",
        "name":  "PZEM Payload",
        "func":  "const p = msg.payload || {};\nconst timestamp = new Date().toISOString();\n\nfunction num(value) {\n    if (value === undefined || value === null || value === \"\") return null;\n\n    const n = Number(value);\n    return Number.isFinite(n) ? n : null;\n}\n\nconst sensor = p.sensor;\nconst master = p.master;\n\nconst data =\n    sensor \u0026\u0026 sensor.ok !== false\n        ? sensor\n        : master \u0026\u0026 master.ok !== false\n            ? master\n            : null;\n\nif (!data) {\n    node.warn(\"No valid PZEM reading found\");\n    return null;\n}\n\nconst voltage = num(data.voltage);\nconst current = num(data.current);\nconst power = num(data.power);\nconst energy = num(data.energy);\n\nif (\n    voltage === null \u0026\u0026\n    current === null \u0026\u0026\n    power === null \u0026\u0026\n    energy === null\n) {\n    node.warn(\"PZEM reading contains no numeric values\");\n    return null;\n}\n\nmsg.headers = {\n    ...(msg.headers || {}),\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    p_device_id: p.device_id || \"esp32-monitoring\",\n    p_readings: [\n        {\n            sensor: \"Rental House\",\n            voltage_v: voltage,\n            current_a: current,\n            power_w: power,\n            energy_kwh: energy,\n            timestamp\n        }\n    ]\n};\n\nreturn msg;",
